# ==========================================
# VALORANT Tournament Operations System (VTO)
# Environment Configuration Template
# ==========================================

# ------------------------------------------
# Database Configuration
# ------------------------------------------
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
# For local development / native Postgres:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vto?schema=public"

# For Docker Compose (using internal service name 'db'):
# DATABASE_URL="postgresql://postgres:postgres@db:5432/vto?schema=public"

# ------------------------------------------
# Authentication & Session Security
# ------------------------------------------
# Generate a secure secret using: openssl rand -base64 32
AUTH_SECRET="vto-change-this-secret-in-production-min-32-chars-long"

# Canonical URL where the application is accessible
# For local development:
NEXTAUTH_URL="http://localhost:3000"

# For LAN deployment (replace with organizer machine IP on venue network):
# NEXTAUTH_URL="http://192.168.1.100:3000"

# For Cloud deployment:
# NEXTAUTH_URL="https://tourney.yourdomain.com"

# ------------------------------------------
# Server & Runtime Configuration
# ------------------------------------------
NODE_ENV="development"
PORT=3000
